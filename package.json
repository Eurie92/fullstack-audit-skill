{
  "name": "fullstack-audit-skill",
  "version": "2.15.0",
  "description": "High-performance architecture atlas and GPS companion for AI coding assistants. Auto-discovers Next.js, React, Vite, Nuxt 3, SvelteKit, Astro, Remix, and React Router v7. Catalogs frontend routes, components, tokens, modals, and pills into docs/frontend-atlas/, and catalogs API routes, Prisma/Drizzle models, server actions, auth guards, and webhooks into docs/backend-atlas/.",
  "type": "module",
  "main": "scripts/audit.ts",
  "bin": {
    "fullstack-audit": "./bin/audit.js",
    "frontend-audit": "./bin/audit.js"
  },
  "scripts": {
    "audit": "node bin/audit.js",
    "audit:frontend": "node bin/audit.js --frontend",
    "audit:backend": "node bin/audit.js --backend",
    "audit:all": "node bin/audit.js --all",
    "audit:theme": "node bin/audit.js --theme",
    "sync:plugin": "powershell -ExecutionPolicy Bypass -File scripts/sync-plugin.ps1",
    "test": "node bin/audit.js",
    "test:frameworks": "npx tsx scripts/test-frameworks.ts",
    "update": "node bin/audit.js --update",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "fullstack-audit",
    "frontend-audit",
    "backend-atlas",
    "design-system",
    "component-atlas",
    "nextjs",
    "react",
    "tailwind",
    "prisma",
    "drizzle",
    "server-actions",
    "agent-skill",
    "antigravity",
    "claude-code",
    "cursor",
    "ui-inventory"
  ],
  "author": "Eurie Paulino",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
