{
  "description": "Iron Gate: blocks unscoped recursive directory walks from Windows shells (they freeze under Windows Defender). Refresh: re-runs the audit in the background after the agent edits source files, so the atlas follows its edits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/iron-gate-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/refresh-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
